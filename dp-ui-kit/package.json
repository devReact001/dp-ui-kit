{
  "name": "@deepak-prasad/dp-ui-kit",
  "version": "1.0.0",
  "description": "A React + TypeScript component library with Tailwind CSS — built for scalable enterprise UI",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run --project unit --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "storybook": "storybook dev -p 6006",
